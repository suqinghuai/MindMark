[basic]
# 循环阅卷次数（0表示无限循环，Ctrl+C手动停止）
loop_count = 10
# 每步操作间隔（秒）
step_delay = 1.0
# 日志文件夹
log_dir = logs

[screenshot]
# 截图区域坐标：左上角x, 左上角y, 宽度, 高度
region_left = 268
region_top = 234
region_width = 949
region_height = 632
# 截图保存路径
save_dir = screenshot

[ai]
# 魔搭社区 API 配置
api_key = YOUR_API_KEY
base_url = https://api-inference.modelscope.cn/v1/
model = Qwen/Qwen3-VL-8B-Instruct
# 最大重试次数
max_retries = 2

[automation]
# 分数输入框坐标
score_input_x = 381
score_input_y = 952
# 提交按钮坐标
submit_btn_x = 1232
submit_btn_y = 808
# 下一题按钮坐标
next_btn_x = 1232
next_btn_y = 808
